<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
        <TargetFrameworks>net472; net10.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<None Remove=".gitignore" />
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="appsettings.*.json" Condition="'$(Configuration)' == 'Debug'">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="xunit.v3" Version="4.0.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="All" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SKIT.FlurlHttpClient.ByteDance.DouyinOpen\SKIT.FlurlHttpClient.ByteDance.DouyinOpen.csproj" />
    </ItemGroup>

</Project>
