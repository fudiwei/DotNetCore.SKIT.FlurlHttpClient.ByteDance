<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0; net462; net6.0; net8.0; net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SKIT.FlurlHttpClient.ByteDance.MicroApp</PackageId>
        <PackageVersion>4.0.0-dev</PackageVersion>
		<PackageIcon>LOGO.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/fudiwei/DotNetCore.SKIT.FlurlHttpClient.ByteDance</PackageProjectUrl>
        <PackageTags>Flurl.Http; ByteDance; MicroApp; 字节; 字节跳动; 头条; 今日头条; 抖音; 字节小程序; 字节跳动小程序; 头条小程序; 今日头条小程序; 抖音小程序</PackageTags>
        <Authors>Fu Diwei</Authors>
        <Description>基于 Flurl.Http 的抖音小程序开放平台 API 客户端 SDK。</Description>
    </PropertyGroup>

	<ItemGroup>
		<None Include="../../LOGO.png" Pack="true" PackagePath="/" />
		<None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="ModelsFixtures/**/*.json" />
        <None Include="EventsFixtures/**/*.json" />
        <None Include="EventsFixtures/**/*.xml" />
	</ItemGroup>

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
        <PackageReference Include="SKIT.FlurlHttpClient.Common" Version="4.0.1" />
        <PackageReference Include="SKIT.JsonConv.NewtonsoftJson" Version="0.1.2" />
        <PackageReference Include="SKIT.JsonConv.SystemTextJson" Version="0.1.2" />
	</ItemGroup>

</Project>
